                {
                        name = "Show_PG2";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"{_x ctrlSetTextColor [0.7,0.074,0.02,0]; }foreach [_hLine,_reticle];" \n
                         "" \n
                         "(findDisplay 46) displayRemoveEventHandler [""KeyDown"", uiNameSpace getVariable [""rhs_2s1_eh"",-1]];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
