                         "" \n
                         "private _distanceNumber = parseNumber ctrlText _distance;" \n
                         "" \n
                         "// Call laser target function" \n
                         "[_vehicle, _distanceNumber] call RHS_fnc_laserTarget;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
