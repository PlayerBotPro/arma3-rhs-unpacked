                         "rhs_key_rng_dwn_GLB		= (profileNamespace getVariable [""rhs_key_rng_dwn"",""ZeroingDown""]);" \n
                         "rhs_key_lase_tgt_GLB    = (profileNamespace getVariable [""rhs_key_lase_tgt"",""LockTarget""]);"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
