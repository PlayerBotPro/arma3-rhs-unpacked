                        name = "Init";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"disableSerialization;" \n
                         "" \n
                         "//systemchat ""start"";" \n
                         "private _c = _this # 0;" \n
                         "" \n
                         "" \n
                         "// UI" \n
                         "" \n
                         "//distance display" \n
                         "private _range = _c displayCtrl 2;" \n
                         "//elevation needed display" \n
