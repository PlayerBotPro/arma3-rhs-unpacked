/*
set gun elevation and launch lead calculation

i:
	_v - vehicle
	_t - distance to target
	_tc - display idd

a: reyhard
*/
disableSerialization;
params["_v","_t","_tc"];

//main display
private _c = uiNamespace getVariable _tc;
//current ammo text
private _a = (_c displayCtrl 3);
//range finder text
private _r = (_c displayCtrl 4);

private _param=0;
private _leadParam=0;

// set visible distance text
if(_t>=1000)then{
	_r ctrlSetText format["%1",_t];
}else{
	if(_t>100)then{_r ctrlSetText format["0%1",_t]}else{
		_r ctrlSetText format["00%1",_t];
	};
};

if(_t!=0)then{
	_mag  = currentMagazine _v;
	// no mag preloaded? use then rhs_loadType (next loaded round) instead
	if(_mag isEqualTo "")then{
		if(isNil "rhs_loadType")exitWith{_t=0};
		private _mA= [_v] call rhs_fnc_ammoIndexing;
		switch(rhs_loadType)do
		{
			case 0: {_mag=_mA select 3};
			case 1: {_mag=_mA select 1};
			case 2: {_mag=_mA select 2};
			case 3: {_mag=_mA select 4};;
		};
	};
	private _magType = getNumber (configFile >> "CfgMagazines" >> _mag >> "rhs_magazineIndex" );
	private _ammo = getText (configFile >> "CfgMagazines" >> _mag >> "ammo" );
	_hAdj=0;

	switch(_magType) do {
		case 1: { // APFSDS
			//emergency sight anims
			if(_t<1400)then{_param=(_t/3000)*1.87}else{_param=(_t/2300)*1.65};

			_hAdj=(-0.08*(_t/1000)^4+0.58*(_t/1000)^3-1.39*(_t/1000)^2+1.42*(_t/1000)-0.87) max -0.4;
			if(_t>4000)then{_hAdj=-_hAdj/6};

			_t=(((_t/780)^3+(_t/780)+33)/235);
			if(count _this >3)then{_a ctrlSetText "Б"}else{_a ctrlSetText "6"};
			_leadParam=1.1;
		};
		case 2: { // HEAT
			//emergency sight anims
			if(_t<1600)then{_k=6.65}else{if(_t<1900)then{_k=6.75}else{if(_t<2400)then{_k=7.05}else{_k=7.85}}};
			_param=(_t/2900)*_k;

			_hAdj=0.0824956*(_t/1000)^4-0.725148*(_t/1000)^3+2.12956*(_t/1000)^2-1.58092*(_t/1000)+0.0289136;
			_t=(((_t/520)^3+(_t/660)+48)/145);
			if(count _this >3)then{_a ctrlSetText "К"}else{_a ctrlSetText "H"};
			_leadParam=1.9;
		};
		case 3: { // HEF
			//emergency sight anims
			if(_t<1900)then{_k=8.95}else{if(_t<2300)then{_k=9.35}else{if(_t<2400)then{_k=9.75}else{_k=13.12}}};
			_param=(_t/4000)*_k;

			_hAdj=((_t/1000)^3+0.7)/10;
			_t=(((_t/361)^3+(_t/540)+57)/147);
			if(count _this >3)then{_a ctrlSetText "О"}else{_a ctrlSetText "0"};
			_leadParam=2.7;
		};
		case 4: { // ATGM
			_t=0;
			if(count _this >3)then{_a ctrlSetText "У"}else{_a ctrlSetText "Y"};
		};
		case 7: { //PKT
			// calculate fire solution for sosna-u sight
			if((_tc == "RHS_essa_Ctrl") OR (_tc == "RHS_Sosna_Ctrl") OR (currentVisionMode (call rhs_fnc_findPlayer) isEqualTo 2) )then{
				_hAdj=6.5445*(_t/1000)^3-10.6349*(_t/1000)^2+8.40977*(_t/1000)-1.35159;
				if(_t>1700)then{_hAdj=5.5};
				 _t=(((_t/312)^3+(_t/210)+57)/112);
				 if(_t<0.84)then{_t=_t*0.65};
				_leadParam=2.1;
			}else{_t=0};

			if(count _this >3)then{_a ctrlSetText "П"}else{_a ctrlSetText "\"};
		};
		default {_t=0;}; // Laser & others
	};
	if(_t!=0)then{_t= [_this select 1,_mag,_ammo,_v,_hAdj] call rhs_fnc_findAngle}else{
		//the gun is elevated 3 degrees above the line of sight to reduce the amount of dust generated by the missile launch
		if(_ammo isKindOf "MissileCore")then{_t=0};
	};
	//systemChat format["t %1",_hAdj];
};

private _p = call rhs_fnc_findPlayer;

private _bank = (_p call BIS_fnc_getPitchBank) select 1;
if(abs(_bank) >6)then{_t=_t*1.05};
[_v,["elev",rad(cos(_bank)*_t)*10000]] remoteExecCall ["animateSource",[_v,_p]];
[_v,["elev_bank",rad(sin(_bank)*_t)*10000]] remoteExecCall ["animateSource",[_v,_p]];
if(_tc == "RHS_1G42_Ctrl")then
{
	//emergency sight
	private _g = _c displayCtrl 1;

	_g ctrlSetPosition [10.32 *   (0.01875 * Safezoneh),(-3.95+_param)*   (0.025 *    SafezoneH),29 *   (0.01875 * SafezoneH),29 *   (0.025 * SafezoneH)];
	_g ctrlCommit 4;
};

if(_leadParam >0)then
{
	[_v,_leadParam,_tc] spawn rhs_fnc_sight_lead;
};