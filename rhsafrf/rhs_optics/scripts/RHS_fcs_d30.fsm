class FSM
{
        fsmName = "D30";
        class States
        {
                /*%FSM<STATE "Init">*/
                class Init
                {
                        name = "Init";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"disableSerialization;" \n
                         "" \n
                         "//systemchat ""start"";" \n
                         "private _c = _this # 0;" \n
                         "" \n
                         "// UI" \n
                         "//vertical line" \n
                         "private _vLine = _c displayCtrl 3;" \n
                         "//horizontal line" \n
                         "private _hLine = _c displayCtrl 4;" \n
                         "// OP5 reticle" \n
                         "private _reticle = _c displayCtrl 5;" \n
                         "//view mode" \n
                         "private _mode= _c displayCtrl 154;" \n
                         "" \n
                         "private _player = call rhs_fnc_findPlayer;" \n
                         "private _vehicle = vehicle _player;" \n
                         "private _modeText = """";" \n
                         "" \n
                         "rhs_key_rng_up_GLB		= (profileNamespace getVariable [""rhs_key_rng_up"",""ZeroingUp""]);" \n
                         "rhs_key_rng_dwn_GLB		= (profileNamespace getVariable [""rhs_key_rng_dwn"",""ZeroingDown""]);" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Continue">*/
                                class Continue
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Main_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Main_Loop">*/
                class Main_Loop
                {
                        name = "Main_Loop";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"//hintSilent format[""%1 %2 %3"",ctrlText _mode, time, _modeText != (ctrlText _mode)];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "UI_missing">*/
                                class UI_missing
                                {
                                        itemno = 6;
                                        priority = 3.000000;
                                        to="End";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isNull _reticle"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "View_mode_change">*/
                                class View_mode_change
                                {
                                        itemno = 3;
                                        priority = 1.000000;
                                        to="Select_view_mode";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_modeText != (ctrlText _mode)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Loop">*/
                                class Loop
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="Main_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Select_view_mode">*/
                class Select_view_mode
                {
                        name = "Select_view_mode";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"_modeText = ctrlText _mode;" \n
                         "//systemchat ""mode changed"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "OP4">*/
                                class OP4
                                {
                                        itemno = 8;
                                        priority = 1.000000;
                                        to="Show_OP4";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_modeText == ""OP4"""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "PG1">*/
                                class PG1
                                {
                                        itemno = 9;
                                        priority = 1.000000;
                                        to="Show_PG1M";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_modeText == ""PG1"""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Continue">*/
                                class Continue
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="Main_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "End">*/
                class End
                {
                        name = "End";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"uiNameSpace setVariable [""RHS_d30_Ctrl"",displayNull];" \n
                         "//systemchat ""end"";" \n
                         "" \n
                         "(findDisplay 46) displayRemoveEventHandler [""KeyDown"", uiNameSpace getVariable [""rhs_d30_eh"",-1]];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Show_PG1M">*/
                class Show_PG1M
                {
                        name = "Show_PG1M";
                        itemno = 10;
                        init = /*%FSM<STATEINIT""">*/"{_x ctrlSetTextColor [0.7,0.074,0.02,0]; }foreach [_hLine,_vLine,_reticle];" \n
                         "" \n
                         "(findDisplay 46) displayRemoveEventHandler [""KeyDown"", uiNameSpace getVariable [""rhs_d30_eh"",-1]];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Continue">*/
                                class Continue
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="Main_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Show_OP4">*/
                class Show_OP4
                {
                        name = "Show_OP4";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"{_x ctrlSetTextColor [0.7,0.074,0.02,1]; }foreach [_hLine,_vLine,_reticle];" \n
                         "" \n
                         "" \n
                         "_id =  (findDisplay 46) displayAddEventHandler [""KeyDown"", {" \n
                         "	params [""_displayorcontrol"", ""_key"", ""_shift"", ""_ctrl"", ""_alt""];" \n
                         "	private _handle = false;" \n
                         "" \n
                         "	private _elevationType = [(configOf cameraon >> ""Turrets"") select (( cameraon unitTurret (call rhs_fnc_findPlayer) ) # 0),""elevationMode"",0] call BIS_fnc_returnConfigEntry;" \n
                         "	" \n
                         "	if((_elevationType >= 1) && !_ctrl)exitWith" \n
                         "	{" \n
                         "		false" \n
                         "	};" \n
                         "" \n
                         "	_moveReticle = " \n
                         "	{" \n
                         "		// exit if play is not in optic mode" \n
                         "		if(cameraView != ""GUNNER"")exitWith{};" \n
                         "" \n
                         "		params[""_dir"",""_type""];" \n
                         "		private _handle = false;" \n
                         "		if(_type == 3)then{_handle=true};" \n
                         "		disableSerialization;" \n
                         "" \n
                         "		private _sight	= (uiNamespace getVariable ""RHS_d30_Ctrl"" displayCtrl 5);" \n
                         "		private _t		= (ctrLPosition _sight) # 1;" \n
                         "		private _move	= _t+0.003*_dir;" \n
                         "		if( (_move <=(4.63 *   (0.025 * SafezoneH))) && (_move >= (-11.13 *   (0.025 * SafezoneH))) )then{" \n
                         "			_sight ctrlSetPosition [(ctrLPosition _sight) # 0,_move];" \n
                         "			_sight ctrlCommit 0.005;" \n
                         "		};" \n
                         "" \n
                         "		//systemchat format[""key move %1 %2"",_t,ctrLPosition _sight];" \n
                         "		_handle" \n
                         "	};" \n
                         "" \n
                         "	// reticle range adjustments" \n
                         "	switch(true) do {" \n
                         "		case (inputAction rhs_key_rng_up_GLB > 0): { _handle = [1,_elevationType] call _moveReticle;};" \n
                         "		case (inputAction rhs_key_rng_dwn_GLB > 0): { _handle = [-1,_elevationType] call _moveReticle };" \n
                         "	};" \n
                         "" \n
                         "	_handle;" \n
                         "}];" \n
                         "" \n
                         "uiNameSpace setVariable [""rhs_d30_eh"",_id];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Continue">*/
                                class Continue
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="Main_Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="Init";
        finalStates[] =
        {
                "End",
        };
};
