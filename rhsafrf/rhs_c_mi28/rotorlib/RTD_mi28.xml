        <Variable name="TailRotor/theta0" alias="Th0u" />

        <Variable name="VerticalStabilizer/controlSurfaceDeflection" alias="directional" />

        <Variable name="velocityBCS" member="Y" alias="Vms" />

      </Variables>
<!--
- clamp(r * 0.02 , -0.5,0.5 )
-->
      <MathExpression>
        <Expression>
          pedals = pedals + clamp(yawRateRad * 3, -0.15 , 0.15 ),
          latCyclic = latCyclic - clamp(rollRateRad * 2, -0.15 , 0.15 ),
          lonCyclic = lonCyclic + clamp(pitchRateRad * 3, -0.15 , 0.15 ),
          A1b = latCyclic * 10.5 ,
          A1u =  -A1b,
          B1u = linearInterp( -10 , 13 , (lonCyclic  +1) * 0.5  ) ,
          B1b = B1u,
          Th0u= collective * 8 + 11 - pedals * clamp(9-Vms*0.06,6,8),
          Th0b= collective * 8 + 11 + pedals * clamp(9-Vms*0.06,6,8),
          A1u = degToRad(A1u),
          B1u = degToRad(B1u),
          Th0u = degToRad(Th0u),
          A1b = degToRad(A1b),
          B1b = degToRad(B1b),
          Th0b = degToRad(Th0b),
          directional=pedals *0,
          mainRotorBrake = rotorBrake
        </Expression>

      </MathExpression>

    </CSComponent>

