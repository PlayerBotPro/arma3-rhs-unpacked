class FSM
{
        fsmName = "missionFlow";
        class States
        {
                /*%FSM<STATE "Move_ZU">*/
                class Move_ZU
                {
                        name = "Move_ZU";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"RHS_helperAction = ""Sign_Sphere25cm_Geometry_F"" createVehicle [0,0,0];" \n
                         "RHS_helperAction attachTo [RHS_Zu23_Player,[0,0,0],""tow_point""];" \n
                         "RHS_helperAction setObjectTexture [0,""""];" \n
                         "" \n
                         "_createTasks = [] spawn {" \n
                         "" \n
                         "	[""RHS_tskPrepareWeapon"", ""SUCCEEDED""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	sleep 1;" \n
                         "" \n
                         "	[""RHS_tskMoveWeapon"", ""ASSIGNED""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	sleep 1;" \n
                         "	[[""RHS_Towing"",""RHS_AFRF_Towing_Dragging""], 15,"""",35,"""",true,true] call BIS_fnc_advHint;" \n
                         "};" \n
                         "" \n
                         "rhs_kraz_01D call BIS_fnc_ambientAnim__terminate;" \n
                         "rhs_kraz_01D addWeapon ""rhs_weap_aks74u"";" \n
                         "rhs_kraz_01D setBehaviour ""SAFE"";" \n
                         "rhs_kraz_01D selectWeapon ""rhs_weap_aks74u"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Player_in_truck">*/
                                class Player_in_truck
                                {
                                        itemno = 79;
                                        priority = 0.000000;
                                        to="Player_moving__t";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(rhs_player_01 in rhs_kraz255_player) ||" \n
                                         "(rhs_player_02 in rhs_kraz255_player)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Court_Martial">*/
                                class Court_Martial
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="Fail1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"// ZU-23 or truck destroyed" \n
                                         "!alive rhs_kraz255_player || !alive rhs_zu23_player" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Left_AO">*/
                                class Left_AO
                                {
                                        itemno = 15;
                                        priority = 0.000000;
                                        to="Fail3";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"missionNameSpace getVariable [""RHS_leftAO"",false];"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "ZU_Moved">*/
                                class ZU_Moved
                                {
                                        itemno = 51;
                                        priority = 0.000000;
                                        to="Attach_ZU";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((rhs_player_01 getVariable [""rhs_towing_dragAction"",-1]) > 0) &&" \n
                                         "((rhs_kraz255_player distance rhs_zu23_player) < 7)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Go_">*/
                class Go_
                {
                        name = "Go_";
                        itemno = 3;
                        init = /*%FSM<STATEINIT""">*/"_createTasks = [] spawn {" \n
                         "	[""rhs_intro"", true, 2] call BIS_fnc_blackIn;" \n
                         "	rhs_officer switchmove ""AmovPercMstpSnonWnonDnon_SaluteIn"";" \n
                         "	rhs_player_01 playMove ""AmovPercMstpSnonWnonDnon_SaluteIn"";" \n
                         "" \n
                         "	sleep 3;" \n
                         "	[""RHS_tskPreparation"", ""CREATED""] call BIS_fnc_missionTasks;" \n
                         "	rhs_player_01 playMove ""AmovPercMstpSnonWnonDnon_SaluteIn"";" \n
                         "" \n
                         "	sleep 1;" \n
                         "	rhs_officer playMove ""AmovPercMstpSnonWnonDnon_SaluteOut"";" \n
                         "" \n
                         "	[""RHS_tskMoveToZU"", ""ASSIGNED""] call BIS_fnc_missionTasks;" \n
                         "" \n
                         "	sleep 1;" \n
                         "	rhs_player_01 reveal rhs_zu23_player;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Cheats">*/
                                class Cheats
                                {
                                        itemno = 99;
                                        priority = 0.000000;
                                        to="Stop_intro";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"cheat1 || cheat2 || cheat3 || cheat4 || cheat5 || cheat6"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Court_Martial">*/
                                class Court_Martial
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="Fail1";
