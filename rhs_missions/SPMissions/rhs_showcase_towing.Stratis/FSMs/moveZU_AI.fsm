                                        condition=/*%FSM<CONDITION""">*/"time > _wait"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "END">*/
                class END
                {
                        name = "END";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"{" \n
                         "	_x doTarget rhs_drone_02;" \n
                         "	_x doWatch rhs_drone_02;" \n
                         "	_x doFire rhs_drone_02;" \n
                         "	_x setCombatMode ""RED"";" \n
                         "	_x setBehaviour ""COMBAT"";" \n
                         "}foreach [rhs_leader1,rhs_soldier1];" \n
                         "rhs_leader1 selectWeapon ""binocular"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
