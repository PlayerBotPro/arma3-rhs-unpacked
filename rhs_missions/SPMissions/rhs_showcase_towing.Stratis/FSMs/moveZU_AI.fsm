class FSM
{
        fsmName = "moveZU_AI";
        class States
        {
                /*%FSM<STATE "START">*/
                class START
                {
                        name = "START";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"{" \n
                         "	_x disableAI ""AUTOCOMBAT"";" \n
                         "	_x setCombatMode ""BLUE"";" \n
                         "	_x setBehaviour ""AWARE"";" \n
                         "}foreach units group rhs_soldier1;" \n
                         "{deleteWaypoint [group rhs_leader1,_foreachindex]}foreach waypoints group rhs_leader1;" \n
                         "rhs_leader1 move (getpos rhs_trainingZone_ai);"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Wait_for_truck">*/
                                class Wait_for_truck
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Move_to_ZU";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"rhs_kraz_01 distance rhs_trainingZone_ai > 30"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Move_to_ZU">*/
                class Move_to_ZU
                {
                        name = "Move_to_ZU";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_wait = time + 5;" \n
                         "rhs_soldier1 doMove (rhs_zu23_01 getpos [0.5,getdir rhs_zu23_01 -180]);" \n
                         "rhs_leader1 doMove (getpos rhs_trainingZone_ai);"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Near_ZU">*/
                                class Near_ZU
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="Drag_ZU";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"rhs_soldier1 distance rhs_zu23_01 < 5"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Not_moving">*/
                                class Not_moving
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Move_to_ZU";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _wait"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Drag_ZU">*/
                class Drag_ZU
                {
                        name = "Drag_ZU";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_fakeAI = [rhs_soldier1,rhs_zu23_01] call rhs_fnc_towing_dragAI;" \n
                         "_fakeAI doMove (getpos rhs_trainingZone_ai);"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "ZU_on_position">*/
                                class ZU_on_position
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Unpack_ZU";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"rhs_soldier1 distance rhs_trainingZone_ai < 4"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Unpack_ZU">*/
                class Unpack_ZU
                {
                        name = "Unpack_ZU";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"deleteVehicle _fakeAI;" \n
                         "[] spawn {" \n
                         "	sleep 1;" \n
                         "	[rhs_zu23_01,0] call rhs_fnc_zu23_pack;" \n
                         "};" \n
                         "rhs_soldier1 doMove (getpos rhs_trainingZone_ai);" \n
                         "_wait = time + 2;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Wait">*/
                                class Wait
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="Get_in_ZU";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _wait"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Get_in_ZU">*/
                class Get_in_ZU
                {
                        name = "Get_in_ZU";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"{" \n
                         "	_x disableAI ""AUTOCOMBAT"";" \n
                         "	_x setCombatMode ""BLUE"";" \n
                         "	_x setBehaviour ""CARELESS"";" \n
                         "	unassignVehicle _x;" \n
                         "}foreach units group rhs_soldier1;" \n
                         "" \n
                         "rhs_soldier1 assignAsGunner rhs_zu23_01;" \n
                         "rhs_leader1 assignAsCommander rhs_zu23_01;" \n
                         "[rhs_leader1,rhs_soldier1] orderGetIn true;" \n
                         "[rhs_leader1,rhs_soldier1] allowGetIn true;" \n
                         "rhs_leader1 reveal rhs_zu23_01;" \n
                         "" \n
                         "_wait = time + 10;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "In_ZU">*/
                                class In_ZU
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="END";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"count (crew rhs_zu23_01) == 2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Stuck">*/
                                class Stuck
                                {
                                        itemno = 10;
                                        priority = 0.000000;
